# Required in production (FLASK_ENV=production)
FOULCAST_SECRET_KEY=generate-a-random-hex-string-here
FLASK_ENV=production
PORT=8080

# --- Foul observation log (Step 8) ---
# Where the SQLite log lives. Defaults to ./data/foul_log.db, which on a
# container with an ephemeral filesystem is DESTROYED AT EVERY REDEPLOY.
# In production point this at a mounted volume. The season ends 2026-09-27 and
# nothing logged can be re-collected.
FOULCAST_LOG_DB=/data/foul_log.db

# Shared secret required to write to (and export from) the log. Leave unset
# locally; set it in production, or anyone who finds /log can put whatever they
# like into the only real dataset in this project.
FOULCAST_LOG_TOKEN=generate-another-random-string
